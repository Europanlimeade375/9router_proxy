TARGET_BACKEND_URL=https://api.openai.com

# Choose one outbound mode. This example enables dynamic public sources.
OUTBOUND_PROXIES=
OUTBOUND_PROXIES_FILE=
PROXY_SOURCES_PATH=proxy-sources.json
ALLOW_DIRECT=false
ALLOW_INSECURE_BACKEND=false

LISTEN_ADDR=127.0.0.1:8080
MODEL_CONFIG_PATH=config.toml
MAX_JSON_BODY_BYTES=2097152
OUTBOUND_CONNECT_TIMEOUT_SECS=10
OUTBOUND_READ_TIMEOUT_SECS=120
SHUTDOWN_GRACE_SECS=30

# Standard local HTTP forward-proxy mode for clients such as 9router.
FORWARD_PROXY_ENABLED=true
FORWARD_PROXY_ALLOWED_HOSTS=*
FORWARD_PROXY_ALLOWED_PORTS=443
FORWARD_CONNECT_TIMEOUT_SECS=15

PROXY_CACHE_PATH=proxy-cache.txt
PROXY_REFRESH_SECS=900
PROXY_WARM_TIMEOUT_SECS=8
PROXY_WARM_CONCURRENCY=50
MAX_PROXY_WARM_CANDIDATES=300
PROXY_CANDIDATES_PER_SOURCE=100
MAX_WARMED_PROXIES=20
PROXY_SOURCE_TIMEOUT_SECS=20
PROXY_SOURCE_MAX_BYTES=5242880
PROXY_LOCAL_FILE_MAX_BYTES=5242880
MAX_PROXY_SOURCES=16
PUBLIC_PROXY_ALLOWED_PORTS=80,81,443,1080,3128,4145,8000,8080,8081,8888,9000,9999,10000

RUST_LOG=info
